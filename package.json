{
  "name": "tech-vault-device-detector",
  "version": "1.0.0",
  "description": "Painel de atendimento técnico empacotado para desktop",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.techvault.painelatendimento",
    "productName": "PainelAtendimento",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "electron-main.js",
      "electron-preload.js",
      "README.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
